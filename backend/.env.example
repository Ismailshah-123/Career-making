# ══════════════════════════════════════════════════════════════════════════
# CareerGPT Backend — Environment Configuration Template
# ══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in real values.
# Never commit your actual `.env` file — it's already in .gitignore.

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=CareerGPT
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
APP_WORKERS=1
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
APP_SECRET_KEY=change-this-to-a-random-64-char-secret
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-this-password
DB_NAME=careergpt

# ── Redis (Celery broker/result backend + caching) ───────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── LLM Providers ─────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional — only needed if you enable OpenAI-backed features
OPENAI_API_KEY=

# ── Vector Store (Qdrant) ─────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=CareerGPT

# ── Storage ──────────────────────────────────────────────────────────────────
# true = save uploaded resumes/avatars to local disk (./uploads)
# false = use S3-compatible storage (fill in AWS_* below)
USE_LOCAL_STORAGE=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_ENDPOINT_URL=

# ── LinkedIn OAuth (optional — required only for LinkedIn features) ──────────
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/linkedin/auth/callback
